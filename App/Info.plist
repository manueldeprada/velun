<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string>velun.icns</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>202608061223</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>velun uses the camera to scan TOTP QR codes (e.g. from Google Authenticator) and import the shared secret into a connection profile.</string>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2025 Manuel de Prada Corral. All rights reserved.</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSSystemExtensionUsageDescription</key>
	<string>velun installs a small system extension that runs the VPN tunnel.</string>
	<!-- Sparkle (auto-update) configuration. Replace SUFeedURL with the URL
	     of the public appcast XML once you have one hosted; SUPublicEDKey is
	     the EdDSA verifying key produced by Sparkle's `generate_keys` tool. -->
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUFeedURL</key>
	<string>https://manueldeprada.com/velun/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>h/Ny0OUx3XrSbr8NOnRdbYCDUVu0OASynukK1yIiEts=</string>
	<!-- velun://… URL scheme — drives the CLI. Tools/velun-cli wraps `open` calls
	     against this scheme; see Tools/velun-cli for the supported actions. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.manueldeprada.velun.url</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>velun</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
